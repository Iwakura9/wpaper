#dashboard {
    width: 100%;
    height: 100%;
}

#top_row {
    height: 1fr;
}

#stats {
    width: 28;
    height: 100%;
    padding: 1 2;
    border-right: solid lightslategrey;
    color: lightsteelblue;
}

#tasks {
    width: 1fr;
    height: 100%;
}

#note_board {
    height: 1fr;
    padding: 1 2;
}

#note_board.grid_view {
    layout: grid;
    grid-size: 4;
    /* 4 content lines (title, meta, tags, linked task) + the card's bottom margin */
    grid-rows: 5;
}

#note_board.kanban_view {
    layout: horizontal;
}

.column {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

.column_header {
    text-style: bold;
    color: lightslategrey;
    content-align: center middle;
    height: 1;
}

.note_card {
    border-left: solid mediumslateblue;
    padding: 0 1;
    margin-bottom: 1;
    color: lightsteelblue;
}

.note_card:focus {
    border-left: solid darkseagreen;
}
