#dashboard {
    width: 100%;
    height: 100%;
}

#top_row {
    height: 1fr;
}

#stats {
    width: 28;
    height: 100%;
    padding: 1 2;
    border-right: solid lightslategrey;
    color: lightsteelblue;
}

#tasks {
    width: 1fr;
    height: 100%;
}

#note_board {
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

#note_board.grid_view {
    layout: grid;
    grid-size: 4;
    /* 2 content lines (title, meta) + the card's bottom margin */
    grid-rows: 3;
}

#note_board.kanban_view {
    layout: horizontal;
}

.column {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

.column_header {
    text-style: bold;
    color: lightslategrey;
    content-align: center middle;
    height: 1;
}

.column_body {
    height: 1fr;
    overflow-y: auto;
}

.note_card {
    border-left: solid mediumslateblue;
    padding: 0 1;
    margin-bottom: 1;
    color: lightsteelblue;
}

/* same status colors as the global search results (search_modal.py's NOTE_STATUS_COLOR) */
.note_card.status-writing {
    border-left: solid #8a6bc7;
}

.note_card.status-done {
    border-left: solid #87d787;
}

.note_card.status-hiatus {
    border-left: solid #d7b287;
}

.note_card.status-abandoned {
    border-left: solid #d78787;
}

.note_card:focus {
    border-left: solid darkseagreen;
}
