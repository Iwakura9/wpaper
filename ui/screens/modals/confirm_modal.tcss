ConfirmModal {
  align: center middle;
}

#confirm_modal {
    width: 52;
    height: 9;
    padding: 1 2 0 2;
    background: $surface;
    align: center middle;
}

#confirm_message {
    width: 100%;
    content-align: center middle;
    text-style: bold;
}

#modal_buttons {
    width: 100%;
    margin-top: 2;
}

#cancel_button {
    dock: left;
}

#confirm_button {
    dock: right;
}
